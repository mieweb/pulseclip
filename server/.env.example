# Server Environment Variables
# This key is used only by the PulseClip server to call AssemblyAI. Do not expose
# it to browser clients or require users to provide it.
ASSEMBLYAI_API_KEY=your_api_key_here
PORT=3001

# Optional: locks the /pulsevault upload lane behind signed, expiring
# capability tokens (minted per pairing by /api/pulsecam/deeplink). Leave
# unset for an open lane (local development).
PULSEVAULT_SECRET=
