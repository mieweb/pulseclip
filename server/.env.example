# Server Environment Variables
# This key is used only by the PulseClip server to call AssemblyAI. Do not expose
# it to browser clients or require users to provide it.
ASSEMBLYAI_API_KEY=your_api_key_here
PORT=3001

# Optional: local Whisper provider (free, offline - requires whisper-cpp + ffmpeg, see README)
# Comma-separated paths each appear as their own provider in the dropdown
# WHISPER_MODEL_PATH=./models/ggml-base.en.bin,./models/ggml-large-v3-turbo-q5_0.bin
# WHISPER_BIN=whisper-cli
# WHISPER_LANGUAGE=auto
